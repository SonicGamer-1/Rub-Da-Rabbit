{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SDL",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "src/*.cpp",
                "-o",
                "bin/rubdarabbits",
                "-lSDL2",
                "-lSDL2_image",
                "-lSDL2_ttf",
                "-lSDL2_mixer"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}